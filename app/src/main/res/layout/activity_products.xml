<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stockly_background"
    android:orientation="vertical">

   <!-- CONTEÚDO COM PADDING -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- SETA VOLTAR -->

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/productsToolbar"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                app:navigationIconTint="#111827" />


            <!-- TÍTULO + SUBTÍTULO -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/products_page_title"
                    android:textColor="#111827"
                    android:textSize="28sp"
                    android:textStyle="bold" />



            </LinearLayout>


            <!-- BOTÃO + -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addProductTopButton"
                style="@style/Widget.Stockly.Button.Text"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/action_add_product"
                android:gravity="center"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+"
                android:textColor="@color/stockly_primary"
                android:textSize="26sp"
                app:cornerRadius="26dp"
                app:strokeColor="@color/stockly_primary_container"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/productsSubtitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/products_page_subtitle"
            android:textAppearance="@style/TextAppearance.Stockly.BodyMedium" />

       <!-- PESQUISA + FILTRO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/productSearchInputLayout"
                style="@style/Widget.Stockly.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/products_search_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/productSearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- FILTRO -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterProductsButton"
                style="@style/Widget.Stockly.Button.Secondary"
                android:layout_width="52dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/action_filter"
                android:gravity="center"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="≡"
                android:textColor="@color/stockly_primary"
                android:textSize="20sp" />

        </LinearLayout>


       <!-- CONTADOR + ORDENAÇÃO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/productsCountLabelTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/products_count_empty"
                android:textAppearance="@style/TextAppearance.Stockly.BodyLarge" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/sortProductsButton"
                style="@style/Widget.Stockly.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/products_sort_recent"
                android:textColor="@color/stockly_primary"
                app:icon="@drawable/ic_arrow_down"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconTint="@color/stockly_primary" />

        </LinearLayout>


       <!-- LISTA DE PRODUTOS -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbars="none" />


       <!-- EMPTY STATE -->

        <LinearLayout
            android:id="@+id/productsEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/products_empty_title"
                android:textAppearance="@style/TextAppearance.Stockly.TitleLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/products_empty_description"
                android:textAppearance="@style/TextAppearance.Stockly.BodyMedium" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>