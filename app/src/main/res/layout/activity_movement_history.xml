<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/movementHistoryMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stockly_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/movementHistoryToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:title="@string/movement_history_title"
        android:titleTextAppearance="@style/TextAppearance.Stockly.TitleLarge" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Stockly.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
        android:layout_marginTop="@dimen/spacing_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/movement_history_filters_title"
                android:textAppearance="@style/TextAppearance.Stockly.TitleLarge" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/movementTypeFilterToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                app:checkedButton="@id/allMovementsFilterButton"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/allMovementsFilterButton"
                    style="@style/Widget.Stockly.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/movement_filter_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/entryMovementsFilterButton"
                    style="@style/Widget.Stockly.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:text="@string/movement_filter_entries" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exitMovementsFilterButton"
                    style="@style/Widget.Stockly.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:text="@string/movement_filter_exits" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/productFilterInputLayout"
                style="@style/Widget.Stockly.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:hint="@string/movement_filter_product_hint"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/productFilterAutoCompleteTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingVertical="@dimen/spacing_12" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startDateFilterButton"
                    style="@style/Widget.Stockly.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/movement_filter_start_date" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/endDateFilterButton"
                    style="@style/Widget.Stockly.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:text="@string/movement_filter_end_date" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearMovementFiltersButton"
                style="@style/Widget.Stockly.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/movement_filter_clear" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/movementHistoryCountTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_12"
        android:textAppearance="@style/TextAppearance.Stockly.BodyMedium" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/movementHistoryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/spacing_24" />

    <LinearLayout
        android:id="@+id/movementHistoryEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/movement_history_empty"
            android:textAppearance="@style/TextAppearance.Stockly.BodyLarge" />

    </LinearLayout>

</LinearLayout>