<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addProductMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stockly_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_vertical"
        android:paddingBottom="@dimen/spacing_32">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/addProductToolbar"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_product_title"
                    android:textColor="#111827"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/add_product_subtitle"
                    android:textAppearance="@style/TextAppearance.Stockly.BodyMedium" />

            </LinearLayout>

        </LinearLayout>


        <!-- NOME -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/addProductNameInputLayout"
            style="@style/Widget.Stockly.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:hint="@string/product_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/addProductNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- CATEGORIA -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/addProductCategoryInputLayout"
            style="@style/Widget.Stockly.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/product_category_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/addProductCategoryEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- QUANTIDADE + STOCK MÍNIMO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/addProductQuantityInputLayout"
                style="@style/Widget.Stockly.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_6"
                android:layout_weight="1"
                android:hint="@string/product_quantity_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/addProductQuantityEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/addProductMinimumStockInputLayout"
                style="@style/Widget.Stockly.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_6"
                android:layout_weight="1"
                android:hint="@string/product_minimum_stock_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/addProductMinimumStockEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- GUARDAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveNewProductButton"
            style="@style/Widget.Stockly.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/action_add_product" />


        <!-- CANCELAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelAddProductButton"
            style="@style/Widget.Stockly.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/action_cancel" />

    </LinearLayout>

</ScrollView>