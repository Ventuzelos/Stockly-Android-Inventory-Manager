<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Display -->
    <style name="TextAppearance.Stockly.DisplayLarge"
        parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/stockly_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Headlines -->
    <style name="TextAppearance.Stockly.HeadlineLarge"
        parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/stockly_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Stockly.HeadlineMedium"
        parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/stockly_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Stockly.HeadlineSmall"
        parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/stockly_on_background</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Titles -->
    <style name="TextAppearance.Stockly.TitleLarge"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/stockly_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Stockly.TitleMedium"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/stockly_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Stockly.TitleSmall"
        parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/stockly_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body -->
    <style name="TextAppearance.Stockly.BodyLarge"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/stockly_on_surface</item>
    </style>

    <style name="TextAppearance.Stockly.BodyMedium"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/stockly_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Stockly.BodySmall"
        parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/stockly_on_surface_variant</item>
    </style>

    <!-- Labels -->
    <style name="TextAppearance.Stockly.LabelLarge"
        parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/stockly_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Stockly.LabelMedium"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/stockly_on_surface_variant</item>
    </style>

    <style name="TextAppearance.Stockly.LabelSmall"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/stockly_on_surface_variant</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Stockly.Button.Primary"
        parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Stockly.LabelLarge</item>
        <item name="backgroundTint">@color/stockly_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="iconTint">@color/stockly_on_primary</item>
        <item name="android:textColor">@color/stockly_on_primary</item>
    </style>

    <style name="Widget.Stockly.Button.Secondary"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Stockly.LabelLarge</item>
        <item name="strokeColor">@color/stockly_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="iconTint">@color/stockly_primary</item>
        <item name="android:textColor">@color/stockly_primary</item>
    </style>

    <style name="Widget.Stockly.Button.Text"
        parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Stockly.LabelLarge</item>
        <item name="android:textColor">@color/stockly_primary</item>
        <item name="iconTint">@color/stockly_primary</item>
    </style>

    <!-- Cards -->
    <style name="Widget.Stockly.Card"
        parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/stockly_surface</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/stockly_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Stockly.Card.Outlined"
        parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/stockly_surface</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stockly_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.Stockly.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/stockly_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_medium</item>
        <item name="boxStrokeColor">@color/stockly_outline</item>
        <item name="hintTextColor">@color/stockly_on_surface_variant</item>
    </style>

    <!-- Chips -->
    <style name="Widget.Stockly.Chip.Filter"
        parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipBackgroundColor">@color/stockly_surface_variant</item>
        <item name="android:textColor">@color/stockly_on_surface</item>
        <item name="chipStrokeColor">@color/stockly_outline_variant</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

</resources>